     end;


     if (success = 1) then
                log('1.21	权限按从小到大顺序添加[功能号: 0x56]	 成功...')
     else
                log('1.21	权限按从小到大顺序添加[功能号: 0x56]	 失败...????');

        	//1.16  获取指定索引号的权限[功能号: 0x5C] **********************************************************************************
    log('读取所有权限	 开始...[1024字节]');
    //以20*10000个卡号为例,
    cardCount := 20*10000;  //2015-06-09 20:20:20 卡总数量   最大20万
    for i:= 0 to  cardCount-1 do
       cardArray[i] := 0;
