        success :=1;
    end;

    recordIndexCurrent:=0;
   	if (ret = 1)  then
  	  Begin
	  	  log('开始提取记录 ...[1024字节指令]');
       //2015-11-07 11:58:06        recordIndexGot := 0; //2015-11-07 11:38:04 强制提取所有记录
        recordIndexToGetStart := recordIndexGot + 1;
