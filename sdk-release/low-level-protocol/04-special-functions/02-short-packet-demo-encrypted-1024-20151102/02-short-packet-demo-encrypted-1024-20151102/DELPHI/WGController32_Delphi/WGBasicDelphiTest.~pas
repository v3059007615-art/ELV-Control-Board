    ret: integer;
    i: integer;
    tries: integer;
    success: integer;

    //与刷卡记录相关变量
    recordIndex, recordType, recordValid, recordDoorNO, recordInOrOut,
    recordCardNO, reason, errCode, sequenceId, relayStatus, otherInputStatus:
               Cardinal;

